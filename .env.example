# =============================================================================
# OrbitCentral — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to git — it contains secrets.
# =============================================================================

# ── PostgreSQL ─────────────────────────────────────────────────────────────
PG_DATABASE=orbitcentral
PG_USER=orbitcentral
PG_PASSWORD=          # REQUIRED — set a strong password
PG_HOST=postgres
PG_PORT=5432

# ── Django ─────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=    # REQUIRED — generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
ALLOWED_HOSTS=localhost,127.0.0.1,orbitcentral.ca,business.orbitcentral.ca,test.orbitcentral.ca
CORS_ALLOWED_ORIGINS=https://orbitcentral.ca,https://test.orbitcentral.ca
CSRF_TRUSTED_ORIGINS=https://orbitcentral.ca,https://test.orbitcentral.ca,https://business.orbitcentral.ca

# ── Celery / Redis ─────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── API Keys ───────────────────────────────────────────────────────────────
OPENAI_API_KEY=       # Required for semantic search & AI features
GOOGLE_PLACES_API_KEY=  # Required for business import & photo proxy

# ── reCAPTCHA v3 ───────────────────────────────────────────────────────────
RECAPTCHA_SECRET_KEY= # Leave empty to disable captcha (dev only)
RECAPTCHA_SCORE_THRESHOLD=0.5

# ── Brevo (transactional email) ────────────────────────────────────────────
BREVO_API_KEY=        # Required for email verification & password reset
BREVO_SENDER_EMAIL=noreply@orbitcentral.ca
BREVO_SENDER_NAME=Orbit
FRONTEND_BASE_URL=https://orbitcentral.ca

# ── Nginx ──────────────────────────────────────────────────────────────────
NGINX_PORT=80
NGINX_SSL_PORT=443

# ── Flower (Celery monitoring dashboard) ───────────────────────────────────
FLOWER_USER=admin
FLOWER_PASSWORD=      # REQUIRED — set a strong password
